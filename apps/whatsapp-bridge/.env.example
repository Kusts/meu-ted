# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Bridge — environment
# Copy to .env (or to repo root .env) and adjust
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0

# Evolution GO API
EVOLUTION_GO_API_URL=http://localhost:4000
EVOLUTION_GO_INSTANCE_TOKEN=your-instance-token-here
EVOLUTION_GO_INSTANCE_NAME=ted

# Allow-list (comma-separated). Leave empty to allow all (dev only).
ALLOWED_GROUP_IDS=
REGISTERED_PHONES=

# Default household passed to Agent Pi for new chats
DEFAULT_HOUSEHOLD_ID=default

# Pi RPC — real pi --mode rpc
PI_AGENT_RUNTIME=pi-native
PI_RPC_COMMAND=pi
PI_RPC_ARGS=["--mode","rpc"]
PI_RPC_TIMEOUT_MS=120000

# ── Reminder semanal (Task Scheduler) ──────────────────────────────────────
# Chat JID que recebe o resumo semanal — grupo (g.us) ou número E.164
REMINDER_TARGET_CHAT_ID=
# Household a consultar (deve existir no banco)
REMINDER_HOUSEHOLD_ID=default
# Quantos dias de transações recentes mostrar (default 7)
REMINDER_SHOW_DAYS=7
