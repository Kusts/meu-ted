{
  "name": "pi-finance-api",
  "version": "0.1.0",
  "private": true,
  "description": "Private finance API for the iPhone finance app. Separate from the WhatsApp bridge (apps/whatsapp-bridge). Demo-backed in-memory read models; persistence later.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsx watch src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "test": "vitest run --exclude=\"tests/integration/**\"",
    "test:all": "vitest run",
    "test:integration": "node ../../scripts/require-reminder-integration-env.mjs && vitest run tests/integration/postgres-reminder-dedupe.test.ts tests/integration/postgres-reminder-lock.test.ts",

    "test:integration:adoption": "node ../../scripts/require-adoption-integration-env.mjs && vitest run tests/integration/postgres-adoption.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "reminders:run": "tsx src/scripts/reminder-job.ts",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:reminders:check": "node ../../scripts/check-reminder-format.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.21.0",
    "web-push": "^3.6.7",
    "better-auth": "^1.6.26",
    "kysely": "^0.29.5",
    "zod": "^3.24.1",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6",
    "prettier": "3.6.2",
    "@biomejs/biome": "2.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
