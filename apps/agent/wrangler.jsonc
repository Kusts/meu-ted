{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-finance-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "FINANCE_CHAT_AGENT", "class_name": "FinanceChatAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["FinanceChatAgent"] },
    { "tag": "v3", "deleted_classes": ["WorkspaceAgent"] }
  ],
  "vars": {
    "API_ORIGIN": "https://api.synkroo.com.br"
    // PWA_ORIGIN (browser origin trusted by CORS) is injected at deploy
    // time (--var PWA_ORIGIN, value from the PWA_PROD_URL repo variable).
    // Never commit the production host here (DEBT2 allowlist migration).
  },
  "observability": { "enabled": true }
}
