# PWA — exemplo de ambiente local (copie para .env.local)
# Não commite .env.local; este arquivo é apenas template sem segredos.
# Produção Cloudflare lê os mesmos valores de apps/pwa/wrangler.jsonc vars.

# API autoritativa — local via proxy same-origin (recomendado para evitar CORS)
# Produção: https://api.synkroo.com.br
NEXT_PUBLIC_PI_FINANCE_API_BASE_URL=/api/backend

# Agent Cloudflare TED — local via proxy same-origin (recomendado)
# Produção: valor de AGENT_PROD_URL (repo variable), injetado no deploy como
# PWA_AGENT_PROXY_ORIGIN (--var) e lido em runtime (com fallback para
# AGENT_ORIGIN). Local/teste: placeholders abaixo, nunca o host real.
# Ver resolveAgentOrigin em src/app/api/agent/[...path]/route.ts.
NEXT_PUBLIC_PI_FINANCE_AGENT_BASE_URL=/api/agent
PWA_AGENT_PROXY_ORIGIN=https://agent.example

# PWA host confiável pelos proxies (spoof de localhost em dev/teste).
# Produção: valor de PWA_PROD_URL (repo variable), injetado no deploy como
# PWA_ORIGIN (--var). Local/teste: placeholder abaixo.
PWA_ORIGIN=https://pwa.example
