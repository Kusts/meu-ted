    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "9.5.11"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@opennextjs/cloudflare": "^1.19.11",
    "@playwright/test": "^1.61.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^8.0.0",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/postcss": "^4",
