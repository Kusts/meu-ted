{
  "name": "pi-financeiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "test": "vitest run --exclude '**/node_modules/**'",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude '**/node_modules/**'",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "db:migrate": "pnpm --filter @pi-financeiro/db migrate",
    "db:studio": "pnpm --filter @pi-financeiro/db studio",
    "db:push": "pnpm --filter @pi-financeiro/db push",
    "db:seed": "pnpm --filter @pi-financeiro/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0",
    "@vitest/coverage-v8": "^3.1.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}