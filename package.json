{
  "name": "pi-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp ↔ Pi RPC bridge (Node). Financial domain lives in the Agent Pi.",
  "scripts": {
    "build": "pnpm --filter @pi-financeiro/whatsapp-bridge build",
    "dev": "pnpm --filter @pi-financeiro/whatsapp-bridge dev",
    "start": "pnpm --filter @pi-financeiro/whatsapp-bridge start",
    "test": "pnpm --filter @pi-financeiro/whatsapp-bridge test",
    "test:watch": "pnpm --filter @pi-financeiro/whatsapp-bridge test:watch",
    "test:coverage": "pnpm --filter @pi-financeiro/whatsapp-bridge test:coverage",
    "typecheck": "pnpm --filter @pi-financeiro/whatsapp-bridge typecheck",
    "lint": "pnpm --filter @pi-financeiro/whatsapp-bridge lint"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
