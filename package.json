{
  "name": "pi-financeiro",
  "version": "0.1.0",
  "private": true,
  "description": "WhatsApp \u00e2\u2020\u201d Pi RPC bridge (Node). Financial domain lives in the Agent Pi.",
  "scripts": {
    "dev": "pnpm --filter @pi-financeiro/whatsapp-bridge dev",
    "start": "pnpm --filter @pi-financeiro/whatsapp-bridge start",
    "build": "pnpm --filter @pi-financeiro/whatsapp-bridge build",
    "build:pwa": "pnpm --filter pwa build",
    "dev:pwa": "pnpm --filter pwa dev",
    "start:pwa": "pnpm --filter pwa start",
    "build:api": "pnpm --filter pi-finance-api build",
    "dev:api": "pnpm --filter pi-finance-api dev",
    "typecheck": "pnpm -r typecheck",
    "typecheck:bridge": "pnpm --filter @pi-financeiro/whatsapp-bridge typecheck",
    "test": "vitest run",
    "test:bridge": "pnpm --filter @pi-financeiro/whatsapp-bridge test",
    "test:pwa": "pnpm --filter pwa test",
    "test:api": "pnpm --filter pi-finance-api test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm --filter @pi-financeiro/whatsapp-bridge lint",
    "reminder": "pnpm --filter @pi-financeiro/whatsapp-bridge reminder"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": ">=7.3.5",
      "postcss": ">=8.5.10",
      "qs": ">=6.15.2",
      "tmp": ">=0.2.3",
      "uuid": ">=9.0.0"
    },
    "onlyBuiltDependencies": [
      "next"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
