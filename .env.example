# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables - pi-financeiro
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# API Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Port for Fastify API server
PORT=3000

# Node environment
NODE_ENV=development

# API Base URL (used by dashboard for API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000

# High value transaction threshold (cents)
# Transactions above this amount go to review queue
HIGH_VALUE_THRESHOLD_CENTS=100000

# ─────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────

# Connection string for PostgreSQL
DATABASE_URL=postgresql://postgres:pi_financeiro_dev_secret@localhost:5432/pi_financeiro

# ─────────────────────────────────────────────────────────────────────────────
# Authentication / WhatsApp
# ─────────────────────────────────────────────────────────────────────────────

# Seed data (used by POST /auth/seed if no body provided)
SEED_HOUSEHOLD_NAME=Casa
SEED_USER_NAME=Usuário
SEED_USER_PHONE=5511999999999

# ─────────────────────────────────────────────────────────────────────────────
# Evolution GO API (WhatsApp Integration)
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for Evolution GO API
EVOLUTION_GO_API_URL=http://localhost:4000

# Instance token (authenticates as a specific WhatsApp instance)
EVOLUTION_GO_INSTANCE_TOKEN=your_instance_token_here

# Instance name (for reference/logging)
EVOLUTION_GO_INSTANCE_NAME=ted

# Webhook callback URL (where Evolution GO sends events)
WEBHOOK_CALLBACK_URL=http://localhost:3000/webhooks/evolution

# ─────────────────────────────────────────────────────────────────────────────
# WhatsApp Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Secret for validating incoming webhook payloads
WEBHOOK_SECRET=your_webhook_secret_here

# Allowed WhatsApp group IDs (comma-separated)
# Leave empty to allow all groups
ALLOWED_GROUP_IDS=

# ─────────────────────────────────────────────────────────────────────────────
# Backup Configuration (REQ-038)
# ─────────────────────────────────────────────────────────────────────────────

# S3 or compatible storage for backups
# S3_BUCKET=pi-financeiro-backups
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose Variables
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection (used in docker-compose)
# POSTGRES_PASSWORD=pi_financeiro_dev_secret
# POSTGRES_DB=pi_financeiro

# ─────────────────────────────────────────────────────────────────────────────
# Agent Runtime Configuration (Step 6 refactor)
# Controls which TED agent runtime to use:
# - pi-native: Uses PiBridge (default) — real pi --mode rpc process
# - disabled: Uses fake client for dev without Pi installed
FINANCE_AGENT_RUNTIME=pi-native

# Controls write mode for financial operations:
# - live: Writes to database normally
# - shadow: Validates but does NOT write (observational mode for testing)
# GET operations (reports, list) always work regardless of this setting
FINANCE_WRITE_MODE=live

# ─────────────────────────────────────────────────────────────────────────────
# Pi RPC Configuration (pi-native mode)
# ─────────────────────────────────────────────────────────────────────────────

# Enable Pi RPC (TED agent)
PI_RPC_ENABLED=false

# Custom Pi command (default: 'pi')
# PI_RPC_COMMAND=pi

# Custom Pi args as JSON array (default: ['--mode', 'rpc'])
# PI_RPC_ARGS=["--mode","rpc"]

# Timeout in milliseconds (default: 30000)
# PI_RPC_TIMEOUT_MS=30000
