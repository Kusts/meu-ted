# Database
DATABASE_URL=postgresql://pi_financeiro:pi_financeiro_dev_secret@localhost:5432/pi_financeiro

# App
NODE_ENV=development
PORT=3000

# WhatsApp / Evolution API
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_WEBHOOK_SECRET=your_webhook_secret_here
WHATSAPP_GROUP_ID=your_group_id_here

# Household seed (first user)
SEED_HOUSEHOLD_NAME=Família
SEED_USER_NAME=Usuário
SEED_USER_PHONE=+5511999999999

# Pi RPC
PI_RPC_MODE=rpc
PI_RPC_TIMEOUT_MS=30000
PI_RPC_QUEUE_LOCK_TIMEOUT_MS=60000

# Financial defaults
HIGH_VALUE_THRESHOLD_CENTS=50000
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_CURRENCY=BRL

# Backup
BACKUP_PATH=./data/backups

# JWT / Sessions (for future use)
# JWT_SECRET=change_me_in_production