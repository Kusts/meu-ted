# Pi isolated container env vars
# Copie para .env.pi e preencha os valores

# Modelo para Pi (opcional, sobrepõe config do Pi)
# PI_MODEL=claude-sonnet-4-20250514

# API keys (requeridas pelo Pi para conectar aos provedores)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Token de autenticação do Pi (se aplicável)
# PI_API_TOKEN=

# Debug opcional
# PI_DEBUG=1