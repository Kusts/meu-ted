# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile for Cron Worker - pi-financeiro
# Runs pg-boss scheduled jobs
# ─────────────────────────────────────────────────────────────────────────────
FROM node:20-alpine AS base

# Install pnpm globally
RUN npm install -g pnpm@9

WORKDIR /app

# Copy workspace files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json ./

# Copy all package.json files for dependency resolution
COPY packages/domain/package.json packages/domain/
COPY packages/jobs/package.json packages/jobs/
COPY packages/db/package.json packages/db/
COPY packages/ledger/package.json packages/ledger/
COPY packages/idempotency/package.json packages/idempotency/
COPY packages/tools/package.json packages/tools/
COPY packages/testkit/package.json packages/testkit/

# Install dependencies (all workspace packages for resolution)
RUN pnpm install --frozen-lockfile

# Copy source code for packages needed by cron worker
COPY packages/domain/src packages/domain/src
COPY packages/domain/tsconfig.json packages/domain/
COPY packages/jobs/src packages/jobs/src
COPY packages/jobs/tsconfig.json packages/jobs/
COPY packages/db/src packages/db/src
COPY packages/db/tsconfig.json packages/db/
COPY packages/ledger/src packages/ledger/src
COPY packages/ledger/tsconfig.json packages/ledger/
COPY packages/idempotency/src packages/idempotency/src
COPY packages/idempotency/tsconfig.json packages/idempotency/
COPY packages/tools/src packages/tools/src
COPY packages/tools/tsconfig.json packages/tools/

# Install tsx for TypeScript execution
RUN npm install -g tsx

# Set environment
ENV NODE_ENV=production

# Entry point - runs pg-boss worker via tsx
CMD ["tsx", "packages/jobs/src/pg-boss-worker.ts"]
